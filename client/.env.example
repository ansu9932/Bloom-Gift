# Copy to .env (development) or .env.production (build)
#
# VITE_API_URL is the API origin. Do NOT include a trailing /api — the app adds
# the /api prefix to every request. (The code also defensively strips a trailing
# /api if present, so an existing ".../api" value will still work.)
#
# Local dev (Vite proxies /api to the backend): leave blank or use the API origin.
VITE_API_URL=http://localhost:3001
#
# Production example (Hostinger):
# VITE_API_URL=https://limegreen-eland-563542.hostingersite.com

VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=BloomGift
