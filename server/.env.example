# Copy to .env and fill in real values
NODE_ENV=development
PORT=3001

# MySQL (Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=bloomgift_user
DB_PASSWORD=change-me-strong-password
DB_NAME=bloomgift_db

# Auth
JWT_SECRET=replace-with-a-minimum-32-character-random-secret-key
JWT_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# CORS — comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173
