# Copy to .env and fill in real values
NODE_ENV=production
# Hostinger sets PORT automatically; 3001 is the local fallback.
PORT=3001

# MySQL (Hostinger → Databases → MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=bloomgift_user
DB_PASSWORD=change-me-strong-password
DB_NAME=bloomgift_db

# Auth
JWT_SECRET=replace-with-a-minimum-32-character-random-secret-key
JWT_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# CORS — comma-separated list of allowed origins. The deployed Hostinger site and
# localhost dev origins are already allowed by default in index.js; add extras here.
CLIENT_ORIGIN=https://limegreen-eland-563542.hostingersite.com,http://localhost:5173
